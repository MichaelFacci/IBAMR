R  = 0.5
Re = 10
MU = 1/Re //8.87e-3       // the viscosity required to attain the specified Reynolds number
RHO = 1
RHO_S = 1.5

// grid spacing parameters
// grid spacing parameters
MAX_LEVELS = 3                            // maximum number of levels in locally refined grid
REF_RATIO  = 4                            // refinement ratio between levels
N = 8                                    // actual    number of grid cells on coarsest grid level
NFINEST = (REF_RATIO^(MAX_LEVELS - 1))*N  // effective number of grid cells on finest   grid level
L = 4.0                                   // length of computational domain
H = 8.0       							// width of the domain
R_COM = L/2 , H - 1.0, 0.0           //center of mass of ball


DX0 = H/N                                      // mesh width on coarsest grid level
DX  = H/NFINEST                                // mesh width on finest   grid level
MFAC = 1.5                                     // ratio of Lagrangian mesh width to Cartesian mesh width
ELEM_TYPE = "TRI3"                            // type of element to use for structure discretization
USE_BOUNDARY_MESH = TRUE

// solver parameters
IB_DELTA_FUNCTION          = "IB_3"            // the type of smoothed delta function to use for Lagrangian-Eulerian interaction
SPLIT_NORMAL_FORCES        = TRUE           // whether to split interior and boundary forces
SPLIT_TANGENTIAL_FORCES	   = TRUE
USE_PRESSURE_JUMP_CONDITIONS        = TRUE           // whether to impose pressure jumps at fluid-structure interfaces
USE_VELOCITY_JUMP_CONDITIONS        = TRUE           // whether to impose pressure jumps at fluid-structure interfaces
WSS_CALC_WIDTH = 1.03
P_CALC_WIDTH = 1.5
COMPUTE_FLUID_TRACTION = TRUE
USE_CONSISTENT_MASS_MATRIX = TRUE          // whether to use a consistent or lumped mass matrix
IB_POINT_DENSITY           = 1.0               // approximate density of IB quadrature points for Lagrangian-Eulerian interaction
SOLVER_TYPE                = "STAGGERED"       // the fluid solver to use (STAGGERED or COLLOCATED)
CFL_MAX                    = 0.1               // maximum CFL number
DT                         = 0.01*CFL_MAX*DX //5e-5    // maximum timestep size
START_TIME                 = 0.0e0             // initial simulation time
END_TIME                   = 2           // final simulation time
GROW_DT                    = 2.0e0             // growth factor for timesteps
CONVECTIVE_TS_TYPE         = "ADAMS_BASHFORTH" // convective time stepping type
CONVECTIVE_OP_TYPE         = "PPM"             // convective differencing discretization type
CONVECTIVE_FORM            = "ADVECTIVE"       // how to compute the convective terms
NORMALIZE_PRESSURE         = TRUE             // whether to explicitly force the  pressure to have mean zero
ERROR_ON_DT_CHANGE         = TRUE              // whether to emit an error message if the time step size changes
VORTICITY_TAGGING          = TRUE              // whether to tag cells for refinement based on vorticity thresholds
TAG_BUFFER                 = 1                 // size of tag buffer used by grid generation algorithm
REGRID_CFL_INTERVAL        = 1.0               // regrid whenever any material point could have moved 0.5 meshwidths since previous regrid
OUTPUT_U                   = TRUE
OUTPUT_P                   = TRUE
OUTPUT_F                   = TRUE
OUTPUT_OMEGA               = TRUE
OUTPUT_DIV_U               = TRUE
ENABLE_LOGGING             = TRUE

// model parameters
KAPPA_S = 2.9152e06//0.0003/DT^2
ETA_S = 0.0 
KAPPA_PLATE = KAPPA_S

//elasticity parameters
USE_ELASTIC_BDRY = FALSE
NCYCLE = 1
SIM_NUM = 9
NUM_CYCLES = 1

PK1_DEV_QUAD_ORDER = "THIRD"
PK1_DIL_QUAD_ORDER = "FIRST"
//U_MAX = 2.0
C1_S = 0.1
P0_S = C1_S
BETA_S = 1.0*(NFINEST/64.0)

STRESS_FUNCTION = "MODIFIED"
USE_VOLUMETRIC_TERM = TRUE
YOUNGS_MOD     = 250
TRACTION_FORCE = 6.25
SHEAR_MOD      = 0.1 //YOUNGS_MOD / 2.0 / (.5 + 1.0)
POISSON_RATIO  = 0.499
BULK_MOD 	   = 2.0 * SHEAR_MOD * (1.0 + POISSON_RATIO) / (3.0 - 6.0 * POISSON_RATIO)
SAFETY         = 0.5

FY = "-981 * RHO"
FX = "0.0"
FZ = "0.0"

// 2 cut parameters
BOTTOM_PLANE_HEIGHT = 4
USE_SECOND_VELOCITY_CORRECTION = TRUE
USE_CURR_MESH_CONFIG = TRUE
USE_PHONG_NORMALS = FALSE
LEFT_END          = 0 + 0.02   //left endpoint of plate
RIGHT_END         =  L - 0.02  //right endpoint of plate
EXTERIOR_CALC_COEF = 0
MESH_NAME = "square_rounded.msh"


// collocated solver parameters
PROJECTION_METHOD_TYPE = "PRESSURE_UPDATE"
SECOND_ORDER_PRESSURE_UPDATE = TRUE

VelocityBcCoefs_0 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "0.0"


   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "1.0"


   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"

}

VelocityBcCoefs_1 {
   acoef_function_0 = "0.0"
   acoef_function_1 = "0.0"
   acoef_function_2 = "1.0"
   acoef_function_3 = "0.0"


   bcoef_function_0 = "1.0"
   bcoef_function_1 = "1.0"
   bcoef_function_2 = "0.0"
   bcoef_function_3 = "1.0"


   gcoef_function_0 = "0.0"
   gcoef_function_1 = "0.0"
   gcoef_function_2 = "0.0"
   gcoef_function_3 = "0.0"

}

ForcingFunction {

  RHO = RHO
  function_0 = FX
  function_1 = FY
}

IBHierarchyIntegrator {
   start_time          = START_TIME
   end_time            = END_TIME
   grow_dt             = GROW_DT
   num_cycles          = NUM_CYCLES
   regrid_cfl_interval = REGRID_CFL_INTERVAL
   dt_max              = DT
   error_on_dt_change  = ERROR_ON_DT_CHANGE
   enable_logging      = ENABLE_LOGGING
}

IIMethod {
   IB_delta_fcn               = IB_DELTA_FUNCTION
   split_normal_force          = SPLIT_NORMAL_FORCES
   split_tangential_force      = SPLIT_TANGENTIAL_FORCES
   use_pressure_jump_conditions        = USE_PRESSURE_JUMP_CONDITIONS
   use_velocity_jump_conditions = USE_VELOCITY_JUMP_CONDITIONS
   use_consistent_mass_matrix = USE_CONSISTENT_MASS_MATRIX
   IB_point_density           = IB_POINT_DENSITY
   compute_fluid_traction     = COMPUTE_FLUID_TRACTION
   wss_calc_width = WSS_CALC_WIDTH
   p_calc_width = P_CALC_WIDTH
   min_ghost_cell_width = 7
   use_second_velocity_correction = USE_SECOND_VELOCITY_CORRECTION
   use_current_mesh_configuration = USE_CURR_MESH_CONFIG
   use_phong_normals              = USE_PHONG_NORMALS
   exterior_calc_coeff            = EXTERIOR_CALC_COEF
}

INSCollocatedHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 0.125,0.25,0.5,1
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
   projection_method_type        = PROJECTION_METHOD_TYPE
   use_2nd_order_pressure_update = SECOND_ORDER_PRESSURE_UPDATE
}
FEMechanicsExplicitIntegrator {
	use_consistent_mass_matrix    = USE_CONSISTENT_MASS_MATRIX
}

INSStaggeredHierarchyIntegrator {
   mu                            = MU
   rho                           = RHO
   start_time                    = START_TIME
   end_time                      = END_TIME
   grow_dt                       = GROW_DT
   convective_time_stepping_type = CONVECTIVE_TS_TYPE
   convective_op_type            = CONVECTIVE_OP_TYPE
   convective_difference_form    = CONVECTIVE_FORM
   normalize_pressure            = NORMALIZE_PRESSURE
   cfl                           = CFL_MAX
   dt_max                        = DT
   using_vorticity_tagging       = VORTICITY_TAGGING
   vorticity_abs_thresh          = 0.125,0.25,0.5,1,2
   tag_buffer                    = TAG_BUFFER
   output_U                      = OUTPUT_U
   output_P                      = OUTPUT_P
   output_F                      = OUTPUT_F
   output_Omega                  = OUTPUT_OMEGA
   output_Div_U                  = OUTPUT_DIV_U
   enable_logging                = ENABLE_LOGGING
}

Main {
   solver_type = SOLVER_TYPE

// log file parameters
   log_file_name               = "IIM2d_RBD_glass.log"
   log_all_nodes               = FALSE

// visualization dump parameters
   viz_writer                  = "VisIt","ExodusII"
   viz_dump_interval           = 200//int(0.01/DT)
   viz_dump_dirname            = "viz_IIM2d_glass"
   visit_number_procs_per_file = 1

// restart dump parameters
   restart_dump_interval       = 0
   restart_dump_dirname        = "restart_IIM2d"

// hierarchy data dump parameters
   data_dump_interval          = int(0.01/DT)
   data_dump_dirname           = "hier_data_IIM2d_glass"

// timer dump parameters
   timer_dump_interval         = 0
}

CartesianGeometry {
   domain_boxes = [ (0,0) , ( N - 1,  int(H/L)*N - 1) ]
   x_lo         =  0,  0         // lower end of computational domain.
   x_up         =   L,   H           // upper end of computational domain.
   periodic_dimension = 0, 0
}


GriddingAlgorithm {
   max_levels = MAX_LEVELS
   ratio_to_coarser {
      level_1 = REF_RATIO,REF_RATIO
      level_2 = REF_RATIO,REF_RATIO
      level_3 = REF_RATIO,REF_RATIO
      level_4 = REF_RATIO,REF_RATIO
      level_5 = REF_RATIO,REF_RATIO
   }
   largest_patch_size {
      level_0 = 256, 256 // largest patch allowed in hierarchy
                          // all finer levels will use same values as level_0...
   }
   smallest_patch_size {
      level_0 = 8, 8  // all finer levels will use same values as level_0
   }
   efficiency_tolerance = 0.80e0  // min % of tag cells in new patch level
   combine_efficiency   = 0.70e0  // chop box if sum of volumes of smaller boxes < efficiency * vol of large box
}

StandardTagAndInitialize {
   tagging_method = "GRADIENT_DETECTOR"
}

LoadBalancer {
   bin_pack_method     = "SPATIAL"
   max_workload_factor = 1
}

TimerManager{
   print_exclusive = FALSE
   print_total = TRUE
   print_threshold = 0.1

   timer_list = "IBAMR::*::*","IBTK::*::*","*::*::*"
}
